using Gtk 4.0;
using Adw 1;

template $CompressPdfWindow: Adw.ApplicationWindow {
  title: _("Compress PDF");
  width-request: 360;
  height-request: 400;

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Button add_button {
        icon-name: "list-add-symbolic";
        tooltip-text: _("Add Files");
        action-name: "win.add-files";
        visible: false;
      }

      [end]
      MenuButton {
        primary: true;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        menu-model: primary_menu;
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      child: Overlay {
        child: Stack stack {
          transition-type: crossfade;

          StackPage {
            name: "empty";

            child: Adw.StatusPage {
              icon-name: "com.itsfoss.CompressPDF";
              title: _("Compress PDF");
              description: _("Drop PDF files here to make them smaller");

              child: Button {
                label: _("_Select Files…");
                use-underline: true;
                halign: center;
                action-name: "win.add-files";

                styles [
                  "pill",
                  "suggested-action",
                ]
              };
            };
          }

          StackPage {
            name: "files";

            child: Adw.PreferencesPage {
              Adw.PreferencesGroup files_group {
                title: _("Files");
              }

              Adw.PreferencesGroup level_group {
                title: _("Compression");
              }
            };
          }
        };

        [overlay]
        Adw.StatusPage drop_overlay {
          visible: false;
          can-target: false;
          icon-name: "folder-download-symbolic";
          title: _("Drop to Add Files");

          styles [
            "drop-overlay",
          ]
        }
      };
    };

    [bottom]
    Box bottom_bar {
      visible: false;
      halign: center;
      margin-top: 12;
      margin-bottom: 12;
      spacing: 12;

      Button compress_button {
        label: _("_Compress");
        use-underline: true;
        action-name: "win.compress";

        styles [
          "pill",
          "suggested-action",
        ]
      }

      Button cancel_button {
        label: _("_Cancel");
        use-underline: true;
        action-name: "win.cancel";
        visible: false;

        styles [
          "pill",
        ]
      }
    }
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Add Files…");
      action: "win.add-files";
    }
  }

  section {
    item {
      label: _("_About Compress PDF");
      action: "app.about";
    }
  }
}
