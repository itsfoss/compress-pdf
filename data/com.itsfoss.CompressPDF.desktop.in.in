[Desktop Entry]
Name=Compress PDF
Comment=Make PDF files smaller
Exec=compress-pdf %F
Icon=@APPLICATION_ID@
Terminal=false
Type=Application
Categories=Office;Utility;
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons. The list MUST also end with a semicolon.
Keywords=pdf;compress;shrink;reduce;size;document;ghostscript;
MimeType=application/pdf;
StartupNotify=true
DBusActivatable=false
