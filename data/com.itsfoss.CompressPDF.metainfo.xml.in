<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.itsfoss.CompressPDF</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Compress PDF</name>
  <summary>Make PDF files smaller</summary>
  <description>
    <p>
      Shrink PDF files so they fit the upload limits of job portals, government
      websites and email. Drop in one or more files, pick how small you need
      them, and choose where to save.
    </p>
    <ul>
      <li>Four simple compression levels</li>
      <li>Compress several files at once</li>
      <li>Never makes a file bigger or overwrites your original</li>
      <li>Works offline, your files never leave your computer</li>
    </ul>
  </description>

  <developer id="com.itsfoss">
    <name>It's FOSS</name>
  </developer>

  <launchable type="desktop-id">com.itsfoss.CompressPDF.desktop</launchable>
  <translation type="gettext">compress-pdf</translation>
  <content_rating type="oars-1.1"/>

  <url type="homepage">https://itsfoss.com/</url>
  <url type="bugtracker">https://github.com/itsfoss/compress-pdf/issues</url>
  <url type="vcs-browser">https://github.com/itsfoss/compress-pdf</url>

  <provides>
    <binary>compress-pdf</binary>
    <mediatype>application/pdf</mediatype>
  </provides>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <branding>
    <color type="primary" scheme_preference="light">#ffbe6f</color>
    <color type="primary" scheme_preference="dark">#613583</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <caption>Pick your files and how small you need them</caption>
      <image>https://raw.githubusercontent.com/itsfoss/compress-pdf/master/data/screenshots/2-files-light.png</image>
    </screenshot>
    <screenshot>
      <caption>See how much each file shrank, and open it straight away</caption>
      <image>https://raw.githubusercontent.com/itsfoss/compress-pdf/master/data/screenshots/3-done-light.png</image>
    </screenshot>
    <screenshot>
      <caption>Drop PDF files in to get started</caption>
      <image>https://raw.githubusercontent.com/itsfoss/compress-pdf/master/data/screenshots/1-start-light.png</image>
    </screenshot>
    <screenshot>
      <caption>Follows your dark style</caption>
      <image>https://raw.githubusercontent.com/itsfoss/compress-pdf/master/data/screenshots/2-files-dark.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="3.0.0" date="2026-09-29" type="stable">
      <description>
        <p>A complete rewrite with GTK 4 and libadwaita.</p>
        <ul>
          <li>Compress several files at once, with progress for each and a Cancel button</li>
          <li>Four compression levels, tuned on real scanned documents</li>
          <li>Never makes a file bigger and never overwrites your files</li>
          <li>Clear messages for password-protected, damaged and non-PDF files</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
